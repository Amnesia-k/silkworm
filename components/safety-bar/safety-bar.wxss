/* 全局安全状态条：白字压在深色实底上，对比度 ≥7:1 —— 蚕房里必须一眼看清 */
.sbar {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
}

.sbar.red { background: #8f1d14; }
.sbar.amber { background: #7a4f0e; }
.sbar.slate { background: #2f3540; }

.sbar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
}

.sbar-detail {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
  margin-top: 6rpx;
}

.sbar-main {
  flex: 1;
  min-width: 0;
}

.sbar-act {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  /* 撑到 88rpx 的点击高度，但用负外边距不让状态条变高 */
  padding: 26rpx 0 26rpx 20rpx;
  margin-top: -26rpx;
  margin-bottom: -26rpx;
}
