/* pages/report/report.wxss —— P06 日报 / 报表私有样式（全局类见 app.wxss） */

.window-text {
  font-size: 22rpx;
  color: #8b95a7;
  margin-top: 12rpx;
}

/* 统计数值里的小单位 */
.unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8b95a7;
  margin-left: 4rpx;
}

/* 逐小时越限时长柱状图 */
.chart-bars {
  width: 100%;
  height: 320rpx;
}

/* 逐小时均值曲线 */
.chart {
  width: 100%;
  height: 420rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8b95a7;
}

.legend-item {
  margin-right: 24rpx;
}

.lg-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.lg-blue { background: #3d6df2; }
.lg-green { background: #10b981; }
.lg-red { background: #ef4444; }

.lg-band {
  display: inline-block;
  width: 22rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: rgba(16, 185, 129, 0.35);
  margin-right: 6rpx;
}

/* 设备启停次数行 */
.sw-item {
  padding: 14rpx 0;
}

.sw-line {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.sw-name {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.sw-kind {
  font-size: 22rpx;
  color: #8b95a7;
  margin-left: 12rpx;
}

.sw-count {
  margin-left: auto;
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 600;
}

.foot-tip {
  margin: 20rpx 24rpx;
}
