/* pages/index —— 看板（Oura 方向打样）
 *
 * 这一页把「两个数字」当主角：暖纸底、无卡片、发丝线分区、衬线大数字、
 * 数字下方一条目标区间刻度尺。状态色只作文字，不再用彩色胶囊。
 */

page {
  background: #f7f1e8;
}

.oura {
  color: #1c1b1a;
}

/* ---------------- 卡片退成「分段」 ---------------- */
.oura .card {
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  margin: 0 36rpx;
  padding: 36rpx 0;
  border-top: 1rpx solid #e1dcd3;
}

.oura .card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1b1a;
}

.oura .card-sub {
  color: #6b6257;
}

.oura .card-more {
  color: #224228;
  font-weight: 600;
}

.oura .badge {
  background: transparent;
  padding-left: 0;
  padding-right: 0;
  font-size: 24rpx;
  font-weight: 600;
}

.oura .badge-green,
.oura .mode-green { color: #224228; }
.oura .badge-orange,
.oura .mode-orange { color: #8a5a12; }
.oura .badge-red,
.oura .mode-red { color: #8f1d14; }
.oura .badge-gray,
.oura .mode-gray { color: #6b6257; }
.oura .badge-blue,
.oura .mode-blue { color: #2454c9; }

.oura .dot-green { background: #224228; }
.oura .dot-gray { background: #b3aa9c; }

.oura .tip {
  color: #6b6257;
}

.oura .empty {
  color: #6b6257;
}

/* ---------------- 生命体征 ---------------- */
.vitals {
  display: flex;
  padding: 12rpx 36rpx 4rpx;
}

.vital {
  flex: 1;
  min-width: 0;
  padding: 24rpx 0 28rpx;
}

.vital + .vital {
  border-left: 1rpx solid #e1dcd3;
  padding-left: 34rpx;
}

.vital-head {
  display: flex;
  align-items: center;
}

.vital-cap {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #6b6257;
}

.vital-upd {
  margin-left: auto;
  font-size: 24rpx;
  color: #6b6257;
}

.vital-num-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.vital-num {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 104rpx;
  line-height: 1.05;
  font-weight: 400;
  letter-spacing: -3rpx;
  color: #1c1b1a;
}

.vital-num.is-out {
  color: #8f1d14;
}

.vital-unit {
  font-size: 26rpx;
  color: #6b6257;
  margin-left: 8rpx;
}

/* 目标区间刻度尺：浅色段＝目标区间，竖线＝当前值 */
.vital-scale {
  position: relative;
  height: 10rpx;
  margin-top: 16rpx;
  background: #e8e1d5;
  border-radius: 999rpx;
}

.vs-band {
  position: absolute;
  top: 0;
  height: 10rpx;
  background: #ced4b8;
  border-radius: 999rpx;
}

.vs-dot {
  position: absolute;
  top: -6rpx;
  width: 6rpx;
  height: 22rpx;
  margin-left: -3rpx;
  background: #224228;
  border-radius: 3rpx;
}

.vs-dot.is-out {
  background: #8f1d14;
}

.vital-foot {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b6257;
}

/* ---------------- 越限提示（暖底 note，无左边框） ---------------- */
.note {
  margin: 6rpx 36rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(175, 117, 27, 0.12);
  border-radius: 6rpx;
}

.note-line {
  font-size: 24rpx;
  color: #7a4f0e;
  line-height: 1.6;
}

.note-act {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #8a5a12;
  padding: 30rpx 0 24rpx;
}

.meta-line {
  margin: 22rpx 36rpx 0;
  font-size: 24rpx;
  color: #6b6257;
  line-height: 1.7;
}

/* ---------------- 曲线 ---------------- */
.chart-card {
  padding-bottom: 20rpx;
}

.chart {
  width: 100%;
  height: 500rpx;
}

.chart-stats {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 8rpx;
  font-size: 24rpx;
  color: #6b6257;
}

.cs-item {
  margin-right: 26rpx;
}

.cs-num {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 30rpx;
  color: #1c1b1a;
  margin: 0 2rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b6257;
}

.legend-item {
  margin-right: 24rpx;
}

.lg-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.lg-ink { background: #224228; }
.lg-sage { background: #849671; }

.lg-band {
  display: inline-block;
  width: 22rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: #ced4b8;
  margin-right: 6rpx;
}

.lg-dash {
  display: inline-block;
  width: 22rpx;
  height: 0;
  border-top: 2rpx dashed #af751b;
  margin-right: 6rpx;
  vertical-align: middle;
}

/* ---------------- 三格速览（发丝线分隔，无卡片） ---------------- */
.mini-grid {
  display: flex;
  margin: 28rpx 36rpx 0;
  border-top: 1rpx solid #e1dcd3;
  border-bottom: 1rpx solid #e1dcd3;
}

.mini-tile {
  flex: 1;
  text-align: center;
  padding: 26rpx 4rpx;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  margin-right: 0;
}

.mini-tile + .mini-tile {
  border-left: 1rpx solid #e1dcd3;
}

.mini-num {
  display: block;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 52rpx;
  font-weight: 400;
  color: #1c1b1a;
  line-height: 1.15;
}

.mini-num.is-alert {
  color: #8f1d14;
}

.mini-num.is-warn {
  color: #8a5a12;
}

.mini-cap {
  display: block;
  font-size: 24rpx;
  color: #6b6257;
  margin-top: 4rpx;
}

/* ---------------- 设备行 ---------------- */
.dev-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ece5d8;
}

.dev-row:last-child {
  border-bottom: none;
}

.dev-name {
  font-size: 28rpx;
  color: #1c1b1a;
  margin-left: 6rpx;
}

.dev-kind {
  font-size: 24rpx;
  color: #6b6257;
  margin-left: 10rpx;
  margin-right: auto;
}

.env-line {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ece5d8;
}

/* ---------------- 告警 ---------------- */
.alarm-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ece5d8;
}

.alarm-row:last-child {
  border-bottom: none;
}

.alarm-head {
  display: flex;
  align-items: center;
}

.alarm-code {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #6b6257;
}

.alarm-time {
  margin-left: auto;
  font-size: 24rpx;
  color: #6b6257;
}

.alarm-text {
  font-size: 28rpx;
  color: #1c1b1a;
  margin-top: 8rpx;
  line-height: 1.6;
}

.foot-tip {
  margin: 24rpx 36rpx;
  color: #6b6257;
}
