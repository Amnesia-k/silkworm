/* pages/login 登录页 */
page {
  background: #f4f6f9;
}

.login-page {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- 品牌区 ---------- */
.brand {
  text-align: center;
  margin-bottom: 56rpx;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #3d6df2, #5b86ff);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 32rpx rgba(61, 109, 242, 0.28);
}

.brand-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2b3d;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b95a7;
}

/* ---------- 卡片 ---------- */
.login-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 43, 61, 0.06);
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #5b6577;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f7f9fc;
  border: 2rpx solid #eef2f8;
  border-radius: 18rpx;
  font-size: 30rpx;
  color: #1f2b3d;
}

.ph {
  color: #b8c0ce;
}

.pwd-wrap {
  position: relative;
}

.pwd-input {
  padding-right: 110rpx;
}

.pwd-eye {
  position: absolute;
  right: 24rpx;
  top: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 24rpx;
  color: #3d6df2;
}

.err {
  margin: -8rpx 0 24rpx;
  padding: 16rpx 20rpx;
  background: #fef2f2;
  border-radius: 14rpx;
  color: #ef4444;
  font-size: 24rpx;
  line-height: 1.5;
}

.btn-login {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #3d6df2;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(61, 109, 242, 0.28);
}

.btn-busy {
  opacity: 0.6;
}

/* ---------- 服务器设置 ---------- */
.adv {
  margin-top: 28rpx;
  border-top: 2rpx solid #eef2f8;
  padding-top: 20rpx;
}

.adv-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.adv-title {
  font-size: 26rpx;
  color: #8b95a7;
}

.adv-arrow {
  font-size: 24rpx;
  color: #3d6df2;
}

.adv-body {
  padding-top: 16rpx;
}

.adv-act {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.adv-tip {
  font-size: 22rpx;
  color: #b8c0ce;
  flex: 1;
}

.adv-save {
  font-size: 26rpx;
  color: #3d6df2;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: #eef3ff;
}

/* ---------- 底部 ---------- */
.skip {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3d6df2;
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b8c0ce;
  line-height: 1.6;
}
