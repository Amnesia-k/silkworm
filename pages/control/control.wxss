/* pages/control/control.wxss —— 仅补充全局样式未覆盖的新类 */

/* 模式徽标：.badge.mode-* 提高优先级，避免与全局 .mode-* 卡片底色冲突 */
.badge.mode-green { background: #e7f9f1; color: #10b981; }
.badge.mode-orange { background: #fef4e6; color: #f59e0b; }
.badge.mode-blue { background: #eaf0ff; color: #3d6df2; }
.badge.mode-red { background: #fdecec; color: #ef4444; }
.badge.mode-gray { background: #eef1f5; color: #8a94a6; }

.card-right { margin-left: auto; }

/* 模式行为说明 */
.mode-behavior {
  margin: 12rpx 0 8rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5b6472;
}

/* 手动倒计时 */
.manual-count {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8a5a00;
}
.manual-count .mono { font-size: 32rpx; font-weight: 700; }

/* 安全锁定卡 */
.lock-card {
  border: 2rpx solid #ef4444;
  background: #fff5f5;
}
.lock-card .card-title { color: #c0392b; }
.unlock-box {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #f0b3b3;
}

/* 通用备注 / 令牌输入框 */
.memo-input {
  margin: 12rpx 0;
  padding: 18rpx 24rpx;
  background: #f4f6f9;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #2c3542;
}

/* 通栏按钮（.btn-row 之外使用） */
.btn-full {
  display: block;
  margin: 16rpx 0;
  text-align: center;
}

/* 设备行 */
.dev-kind { margin-left: 12rpx; }
.sw-btn {
  min-width: 120rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #3d6df2;
  background: #eaf0ff;
  border: 2rpx solid #c9d9ff;
}
.sw-btn.sw-on {
  color: #10b981;
  background: #e7f9f1;
  border-color: #b8ecd6;
}

/* 令牌 */
.token-issued {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #e7f9f1;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #0f7a58;
}
.revoke-btn {
  margin-top: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ef4444;
  background: #fdecec;
  border: 2rpx solid #f7c6c6;
  text-align: center;
}

/* 联锁说明 */
.il-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.il-row:last-child { border-bottom: none; }
.il-head {
  display: flex;
  align-items: center;
}
.il-code {
  min-width: 64rpx;
  margin-right: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  color: #5b6472;
  background: #eef1f5;
}
.il-code.il-danger {
  color: #ffffff;
  background: #ef4444;
}
.il-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3542;
}
.il-tag { margin-left: auto; }
