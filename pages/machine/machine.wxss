.page {
  padding-bottom: 40rpx;
}

/* ---------------- 概要 ---------------- */
.mini-grid {
  display: flex;
  margin-top: 16rpx;
}

.mini-tile {
  flex: 1;
  background: #f7f9fc;
  border-radius: 14rpx;
  padding: 20rpx 8rpx;
  margin-right: 14rpx;
  text-align: center;
}

.mini-tile:last-child {
  margin-right: 0;
}

.mini-tile.warn {
  background: rgba(245, 158, 11, 0.12);
}

.mini-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
}

.mini-tile.warn .mini-num {
  color: #f59e0b;
}

.mini-cap {
  display: block;
  font-size: 21rpx;
  color: #8b95a7;
  margin-top: 6rpx;
}

.token-row {
  margin-top: 16rpx;
}

.token-input {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

/* ---------------- 机械卡 ---------------- */
.dev-kind {
  font-size: 21rpx;
  color: #a8b1c0;
  margin-left: 10rpx;
}

.m-spec {
  font-size: 22rpx;
  color: #8b95a7;
  line-height: 1.6;
  padding: 12rpx 0 6rpx;
}

.m-sec {
  margin-top: 18rpx;
  border-top: 1rpx solid #f0f3f8;
  padding-top: 16rpx;
}

.m-sec-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #3d4a5c;
  margin-bottom: 10rpx;
}

/* ---------------- 参数行 ---------------- */
.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f7fb;
}

.p-row:last-child {
  border-bottom: none;
}

.p-main {
  flex: 1;
  min-width: 0;
}

.p-label {
  font-size: 26rpx;
  color: #253044;
}

.p-preset {
  font-size: 20rpx;
  color: #a8b1c0;
  margin-top: 4rpx;
}

.p-side {
  display: flex;
  align-items: center;
}

.p-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-right: 12rpx;
}

.p-val.p-out {
  color: #f59e0b;
}

/* ---------------- 病蚕识别记录（后端接口） ---------------- */
.api-warn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}

.api-warn-text {
  flex: 1;
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.5;
}

.api-warn-act {
  font-size: 22rpx;
  color: #f59e0b;
  font-weight: 600;
  margin-left: 12rpx;
}

.dz-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f7fb;
}

.dz-row:last-child {
  border-bottom: none;
}

.dz-thumb-wrap {
  width: 132rpx;
  height: 132rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eef2f8;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dz-thumb {
  width: 132rpx;
  height: 132rpx;
}

.dz-main {
  flex: 1;
  min-width: 0;
}

.dz-pos {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #253044;
}

.dz-count {
  font-size: 21rpx;
  font-weight: 400;
  color: #ef4444;
  margin-left: 12rpx;
}

.dz-meta {
  font-size: 22rpx;
  color: #8b95a7;
  line-height: 1.6;
  margin-top: 4rpx;
}

.dz-env {
  font-size: 21rpx;
  color: #6b7688;
  background: #f7f9fc;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  margin-top: 8rpx;
}

.dz-badges {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.dz-badges .badge {
  margin: 0 8rpx 6rpx 0;
}

.dz-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.btn-mini {
  min-width: 108rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 600;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.btn-mini.btn-yes {
  background: #e8f8f1;
  color: #0f9d6b;
  border: 1rpx solid #b7ead4;
}

.btn-mini.btn-no {
  background: #f4f6f9;
  color: #6b7688;
  border: 1rpx solid #eef2f8;
}

.btn-mini.btn-busy {
  opacity: 0.55;
}

/* ---------------- 夹取作业 ---------------- */
.job-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f7fb;
}

.job-item:last-child {
  border-bottom: none;
}

.job-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.job-pos {
  font-size: 27rpx;
  font-weight: 600;
  color: #253044;
}

.job-line {
  font-size: 23rpx;
  color: #6b7688;
  line-height: 1.7;
}

.job-foot {
  margin-top: 8rpx;
}

/* ---------------- 变更记录 ---------------- */
.log-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f7fb;
}

.log-row:last-child {
  border-bottom: none;
}

.log-time {
  width: 150rpx;
  font-size: 20rpx;
  color: #a8b1c0;
  flex-shrink: 0;
}

.log-text {
  flex: 1;
  font-size: 22rpx;
  color: #6b7688;
  line-height: 1.5;
}

.btn-flex {
  flex: 1;
}

.foot-tip {
  margin: 8rpx 24rpx 0;
  font-size: 21rpx;
  color: #a8b1c0;
  line-height: 1.6;
}

/* ---------------- 弹层 ---------------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx 40rpx;
  z-index: 91;
  box-shadow: 0 -8rpx 32rpx rgba(31, 41, 55, 0.14);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.sheet-sub {
  font-size: 22rpx;
  color: #8b95a7;
  margin-top: 8rpx;
  line-height: 1.6;
}

.sheet-field {
  margin-top: 24rpx;
}

.sheet-label {
  display: block;
  font-size: 23rpx;
  color: #6b7688;
  margin-bottom: 10rpx;
}

.sheet-input {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #253044;
}

.sheet-double,
.sheet-triple {
  display: flex;
}

.sheet-input.half {
  flex: 1;
  margin-right: 14rpx;
}

.sheet-input.half:last-child {
  margin-right: 0;
}

.sheet-input.third {
  flex: 1;
  margin-right: 14rpx;
  text-align: center;
}

.sheet-input.third:last-child {
  margin-right: 0;
}

.sheet-tip {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #a8b1c0;
  line-height: 1.6;
}

.sheet-btns {
  display: flex;
  margin-top: 24rpx;
}

.sheet-btns .btn-ghost,
.sheet-btns .btn-primary {
  flex: 1;
  margin-right: 16rpx;
}

.sheet-btns .btn-ghost:last-child,
.sheet-btns .btn-primary:last-child {
  margin-right: 0;
}
